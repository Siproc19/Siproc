<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulario de la oportunidad: pestaña "Upside / Plan B" -->
    <record id="crm_lead_view_form_siproc" model="ir.ui.view">
        <field name="name">crm.lead.form.siproc</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="siproc_upside" string="Upside / Plan B" invisible="type == 'lead'">
                    <group>
                        <group>
                            <field name="plan_tipo" widget="radio" options="{'horizontal': true}"/>
                            <field name="fecha_inicio"/>
                            <field name="date_deadline" string="Fecha fin"/>
                        </group>
                        <group>
                            <field name="avance_id" options="{'no_create': True}"/>
                            <field name="sincronizar_ingreso"/>
                            <field name="company_currency" invisible="1"/>
                        </group>
                    </group>
                    <div class="mb-2">
                        <button name="action_cargar_productos_cotizacion" type="object" icon="fa-download"
                                string="Cargar productos de la cotización" class="btn-secondary"
                                invisible="not order_ids"
                                confirm="Se reemplazarán los productos de esta pestaña por los de la cotización más reciente. ¿Continuar?"/>
                        <field name="order_ids" invisible="1"/>
                    </div>
                    <separator string="Comentario semanal"/>
                    <field name="comentario_semanal" placeholder="Ej. Esperando la orden de compra; enviar tallaje el lunes."/>
                    <separator string="Productos del proyecto"/>
                    <field name="upside_line_ids" context="{'default_fecha_inicio': fecha_inicio, 'default_fecha_fin': date_deadline}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id" optional="hide"/>
                            <field name="name"/>
                            <field name="unidades"/>
                            <field name="monto" sum="Total"/>
                            <field name="frecuencia"/>
                            <field name="valor_cliente" sum="Total"/>
                            <field name="fecha_inicio" optional="hide"/>
                            <field name="fecha_fin" optional="hide"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="unidades_total"/>
                        <field name="monto_total"/>
                        <field name="valor_cliente_total"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Lista del pipeline: columnas opcionales -->
    <record id="crm_case_tree_view_oppor_siproc" model="ir.ui.view">
        <field name="name">crm.lead.list.opportunity.siproc</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="plan_tipo" optional="show"/>
                <field name="monto_total" optional="hide" sum="Total"/>
                <field name="valor_cliente_total" optional="show" sum="Total"/>
                <field name="avance_id" optional="show" options="{'no_create': True}"/>
                <field name="comentario_semanal" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Búsqueda: filtros por plan y agrupar por plan -->
    <record id="view_crm_case_opportunities_filter_siproc" model="ir.ui.view">
        <field name="name">crm.lead.search.opportunity.siproc</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='open_opportunities']" position="after">
                <separator/>
                <filter string="Upside Potential" name="plan_upside" domain="[('plan_tipo', '=', 'upside')]"/>
                <filter string="Plan B" name="plan_b" domain="[('plan_tipo', '=', 'plan_b')]"/>
                <filter string="Prospección" name="plan_prospeccion" domain="[('plan_tipo', '=', 'prospeccion')]"/>
                <filter string="Fecha de pérdida" name="fecha_perdido" date="fecha_perdido"/>
                <filter string="Plan" name="groupby_plan" context="{'group_by': 'plan_tipo'}"/>
                <filter string="Valor de avance" name="groupby_avance" context="{'group_by': 'avance_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
