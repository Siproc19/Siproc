<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Resumen por oportunidad: incluye prospecciones sin productos, ganados y perdidos -->
    <record id="crm_lead_view_list_upside" model="ir.ui.view">
        <field name="name">crm.lead.list.upside.siproc</field>
        <field name="model">crm.lead</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Upside SIPROC" multi_edit="1" decoration-success="won_status == 'won'"
                  decoration-muted="won_status == 'lost'">
                <header>
                    <button name="%(siproc_crm_upside.action_upside_report_wizard)d" type="action"
                            string="Descargar reporte semanal" class="btn-primary" display="always"/>
                </header>
                <field name="partner_id" string="Cliente"/>
                <field name="name" string="Proyecto"/>
                <field name="plan_tipo" optional="hide"/>
                <field name="valor_reporte" sum="Total"/>
                <field name="monto_reporte" sum="Total"/>
                <field name="unidades_total" string="Unidades" sum="Total" optional="show"/>
                <field name="fecha_inicio" optional="show"/>
                <field name="date_deadline" string="Fecha fin" optional="show"/>
                <field name="avance_id" options="{'no_create': True}"/>
                <field name="comentario_semanal" string="Comentarios"/>
                <field name="probability" string="Prob. %" avg="Promedio"/>
                <field name="stage_id" optional="show"/>
                <field name="lost_reason_id" optional="hide"/>
                <field name="date_closed" optional="hide"/>
                <field name="fecha_perdido" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="won_status" column_invisible="True"/>
                <field name="company_currency" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_upside_resumen" model="ir.actions.act_window">
        <field name="name">Upside Potential y Plan B</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="view_id" ref="crm_lead_view_list_upside"/>
        <field name="search_view_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="domain">[('type', '=', 'opportunity'), ('plan_tipo', 'in', ('upside', 'plan_b'))]</field>
        <field name="context">{'search_default_filter_won_status_pending': 1, 'search_default_groupby_plan': 1}</field>
    </record>
    <record id="action_upside_prospeccion" model="ir.actions.act_window">
        <field name="name">Prospección</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="crm_lead_view_list_upside"/>
        <field name="search_view_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="domain">[('type', '=', 'opportunity'), ('plan_tipo', '=', 'prospeccion')]</field>
        <field name="context">{'search_default_filter_won_status_pending': 1, 'default_plan_tipo': 'prospeccion'}</field>
    </record>
    <record id="action_upside_ganados" model="ir.actions.act_window">
        <field name="name">Clientes ganados</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="view_id" ref="crm_lead_view_list_upside"/>
        <field name="search_view_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="domain">[('type', '=', 'opportunity'), ('plan_tipo', '!=', False)]</field>
        <field name="context">{'search_default_filter_won_status_won': 1, 'search_default_close_date': 1}</field>
    </record>
    <record id="action_upside_perdidos" model="ir.actions.act_window">
        <field name="name">Clientes perdidos</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="crm_lead_view_list_upside"/>
        <field name="search_view_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="domain">[('type', '=', 'opportunity'), ('plan_tipo', '!=', False)]</field>
        <field name="context">{'search_default_filter_won_status_lost': 1, 'search_default_fecha_perdido': 1}</field>
    </record>
</odoo>
