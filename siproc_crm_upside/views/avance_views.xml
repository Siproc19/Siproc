<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="siproc_avance_view_list" model="ir.ui.view">
        <field name="name">siproc.avance.list</field>
        <field name="model">siproc.avance</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="peso"/>
            </list>
        </field>
    </record>

    <record id="action_siproc_avance" model="ir.actions.act_window">
        <field name="name">Valor de avance</field>
        <field name="res_model">siproc.avance</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
