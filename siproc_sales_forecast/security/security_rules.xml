<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_sop_salesman_own" model="ir.rule">
            <field name="name">SOP: vendedor solo sus propios SOP</field>
            <field name="model_id" ref="model_siproc_sales_forecast"/>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>
        <record id="rule_sop_manager_all" model="ir.rule">
            <field name="name">SOP: gerencia ve todos los SOP</field>
            <field name="model_id" ref="model_siproc_sales_forecast"/>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_sop_line_salesman_own" model="ir.rule">
            <field name="name">SOP: vendedor solo sus propias líneas</field>
            <field name="model_id" ref="model_siproc_sales_forecast_line"/>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>
        <record id="rule_sop_line_manager_all" model="ir.rule">
            <field name="name">SOP: gerencia ve todas las líneas</field>
            <field name="model_id" ref="model_siproc_sales_forecast_line"/>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
