<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="siproc_sop_report_wizard_view_form" model="ir.ui.view">
        <field name="name">siproc.sop.report.wizard.form</field>
        <field name="model">siproc.sop.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Descargar SOP (Excel)">
                <group>
                    <label for="fecha_desde" string="Período"/>
                    <div class="o_row">
                        <field name="fecha_desde"/> <span>al</span> <field name="fecha_hasta"/>
                    </div>
                    <field name="user_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_descargar" type="object" string="Descargar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_siproc_sop_report_wizard" model="ir.actions.act_window">
        <field name="name">Descargar SOP (Excel)</field>
        <field name="res_model">siproc.sop.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
