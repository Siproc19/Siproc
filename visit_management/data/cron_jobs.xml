<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Alerta: Visitas sin Check-In (cada hora) -->
        <record id="cron_visit_alert_no_checkin" model="ir.cron">
            <field name="name">Visitas: Alerta por falta de Check-In</field>
            <field name="model_id" ref="visit_management.model_visit_visit"/>
            <field name="state">code</field>
            <field name="code">model._cron_alert_missing_checkin()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <!-- Alerta: Visitas sin Check-Out (al inicio del día siguiente) -->
        <record id="cron_visit_alert_no_checkout" model="ir.cron">
            <field name="name">Visitas: Alerta por falta de Check-Out</field>
            <field name="model_id" ref="visit_management.model_visit_visit"/>
            <field name="state">code</field>
            <field name="code">model._cron_alert_no_checkout()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Recordatorio diario a asesores (7 AM) -->
        <record id="cron_visit_daily_reminder" model="ir.cron">
            <field name="name">Visitas: Recordatorio diario a asesores</field>
            <field name="model_id" ref="visit_management.model_visit_visit"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_daily_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
