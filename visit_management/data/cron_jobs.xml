<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_visit_alert_no_checkin" model="ir.cron">
            <field name="name">Visitas: Alerta falta de Check-In</field>
            <field name="model_id" ref="visit_management.model_visit_visit"/>
            <field name="state">code</field>
            <field name="code">model._cron_alert_missing_checkin()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_visit_alert_no_checkout" model="ir.cron">
            <field name="name">Visitas: Alerta falta de Check-Out</field>
            <field name="model_id" ref="visit_management.model_visit_visit"/>
            <field name="state">code</field>
            <field name="code">model._cron_alert_no_checkout()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
