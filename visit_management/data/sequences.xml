<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_visit_visit" model="ir.sequence">
            <field name="name">Secuencia Visitas</field>
            <field name="code">visit.visit</field>
            <field name="prefix">VIS/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_visit_route" model="ir.sequence">
            <field name="name">Secuencia Rutas</field>
            <field name="code">visit.route</field>
            <field name="prefix">RUTA/%(year)s/%(month)s/</field>
            <field name="padding">3</field>
        </record>
    </data>
</odoo>
