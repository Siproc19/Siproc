<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_visit_pivot" model="ir.ui.view">
        <field name="name">visit.visit.pivot</field>
        <field name="model">visit.visit</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="employee_id" type="row"/>
                <field name="visit_type" type="col"/>
                <field name="km_traveled" type="measure"/>
                <field name="fuel_cost" type="measure"/>
                <field name="duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_visit_graph" model="ir.ui.view">
        <field name="name">visit.visit.graph</field>
        <field name="model">visit.visit</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="employee_id"/>
            </graph>
        </field>
    </record>

    <record id="action_visit_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard Gerencial</field>
        <field name="res_model">visit.visit</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>

    <record id="action_visit_fuel_report" model="ir.actions.act_window">
        <field name="name">Reporte KM y Combustible</field>
        <field name="res_model">visit.visit</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[('state','=','done')]</field>
    </record>

</odoo>
