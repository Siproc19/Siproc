<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard Gerencial de Visitas -->
    <record id="view_visit_dashboard" model="ir.ui.view">
        <field name="name">visit.visit.dashboard</field>
        <field name="model">visit.visit</field>
        <field name="arch" type="xml">
            <list string="Dashboard Visitas" create="false">
                <field name="employee_id" />
                <field name="scheduled_date"/>
                <field name="partner_id"/>
                <field name="visit_type"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state in ('en_route','in_process')"
                       decoration-danger="state == 'cancelled'"/>
                <field name="gps_valid" />
                <field name="duration" widget="float_time"/>
                <field name="km_traveled"/>
                <field name="fuel_cost" />
                <field name="result" widget="badge"
                       decoration-success="result == 'positive'"
                       decoration-danger="result == 'negative'"
                       decoration-warning="result == 'neutral'"/>
            </list>
        </field>
    </record>

    <!-- Pivot para análisis -->
    <record id="view_visit_pivot" model="ir.ui.view">
        <field name="name">visit.visit.pivot</field>
        <field name="model">visit.visit</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Visitas" disable_linking="1">
                <field name="employee_id" type="row"/>
                <field name="visit_type"  type="col"/>
                <field name="scheduled_date" type="col" interval="month"/>
                <field name="km_traveled"    type="measure"/>
                <field name="fuel_cost"      type="measure"/>
                <field name="duration"       type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph para KPIs -->
    <record id="view_visit_graph" model="ir.ui.view">
        <field name="name">visit.visit.graph</field>
        <field name="model">visit.visit</field>
        <field name="arch" type="xml">
            <graph string="KPIs de Visitas" type="bar">
                <field name="employee_id" type="row"/>
                <field name="scheduled_date" type="col" interval="month"/>
            </graph>
        </field>
    </record>

    <!-- Action Dashboard Gerencial -->
    <record id="action_visit_dashboard" model="ir.actions.act_window">
        <field name="name">📊 Dashboard Gerencial</field>
        <field name="res_model">visit.visit</field>
        <field name="view_mode">graph,pivot,list,calendar</field>
        <field name="context">{
            }</field>
    </record>

    <!-- Action KM y Combustible -->
    <record id="action_visit_fuel_report" model="ir.actions.act_window">
        <field name="name">⛽ Reporte KM y Combustible</field>
        <field name="res_model">visit.visit</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[('state','=','done')]</field>
        <field name="context">{
            'group_by': ['employee_id']
        }</field>
    </record>

</odoo>
