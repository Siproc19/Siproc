<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORM -->
    <record id="view_visit_form" model="ir.ui.view">
        <field name="name">visit.visit.form</field>
        <field name="model">visit.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_route" string="Iniciar Ruta"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_checkin" string="Check-In"
                            type="object" class="btn-primary"
                            invisible="state != 'en_route'"/>
                    <button name="action_checkout" string="Finalizar Visita"
                            type="object" class="btn-success"
                            invisible="state != 'in_process'"/>
                    <button name="action_reschedule" string="Reprogramar"
                            type="object"
                            invisible="state in ('done', 'in_process')"/>
                    <button name="action_cancel" string="Cancelar"
                            type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft" string="Reactivar"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,en_route,in_process,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_google_maps" type="object"
                                class="oe_stat_button" icon="fa-map-marker">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Google Maps</span>
                            </div>
                        </button>
                        <button name="action_open_waze" type="object"
                                class="oe_stat_button" icon="fa-road">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Waze</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <notebook>
                        <page string="General" name="general">
                            <group>
                                <group>
                                    <field name="visit_type"/>
                                    <field name="employee_id"/>
                                    <field name="partner_id"/>
                                    <field name="contact_id"/>
                                    <field name="priority" widget="priority"/>
                                </group>
                                <group>
                                    <field name="scheduled_date"/>
                                    <field name="scheduled_time" widget="float_time"/>
                                    <field name="real_start_time"/>
                                    <field name="real_end_time"/>
                                    <field name="duration"/>
                                </group>
                            </group>
                            <group>
                                <field name="visit_objective"/>
                            </group>
                            <group>
                                <group>
                                    <field name="crm_lead_id"/>
                                    <field name="sale_order_id"/>
                                </group>
                                <group>
                                    <field name="result" invisible="state != 'done'"/>
                                    <field name="next_action" invisible="state != 'done'"/>
                                </group>
                            </group>
                            <div invisible="state != 'done'">
                                <button name="action_create_opportunity"
                                        string="Crear Oportunidad CRM"
                                        type="object" class="btn btn-secondary"/>
                                <button name="action_create_quotation"
                                        string="Crear Cotizacion"
                                        type="object" class="btn btn-secondary"/>
                            </div>
                        </page>
                        <page string="Geolocalizacion" name="geo">
                            <group>
                                <group string="Ubicacion del Cliente">
                                    <field name="client_address"/>
                                    <field name="client_latitude"/>
                                    <field name="client_longitude"/>
                                </group>
                                <group string="Validacion GPS">
                                    <field name="gps_tolerance"/>
                                    <field name="gps_distance"/>
                                    <field name="gps_valid"/>
                                </group>
                            </group>
                            <group>
                                <group string="Check-In">
                                    <field name="checkin_latitude"/>
                                    <field name="checkin_longitude"/>
                                    <field name="checkin_address"/>
                                    <field name="checkin_accuracy"/>
                                </group>
                                <group string="Check-Out">
                                    <field name="checkout_latitude"/>
                                    <field name="checkout_longitude"/>
                                    <field name="checkout_address"/>
                                    <field name="checkout_accuracy"/>
                                </group>
                            </group>
                            <field name="checkin_ids">
                                <list editable="bottom" create="false">
                                    <field name="checkin_type"/>
                                    <field name="timestamp"/>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                    <field name="address"/>
                                    <field name="accuracy_m"/>
                                </list>
                            </field>
                        </page>
                        <page string="KM y Combustible" name="fuel">
                            <group>
                                <group string="Odometro">
                                    <field name="vehicle_config_id"/>
                                    <field name="km_initial"/>
                                    <field name="km_final"/>
                                    <field name="km_traveled"/>
                                </group>
                                <group string="Costo Estimado">
                                    <field name="fuel_consumption"/>
                                    <field name="fuel_cost"/>
                                </group>
                            </group>
                        </page>
                        <page string="Cierre y Evidencias" name="closure">
                            <group>
                                <field name="closing_notes"/>
                            </group>
                            <group>
                                <field name="attachment_ids" widget="many2many_binary"/>
                            </group>
                            <group>
                                <field name="signature_name"/>
                                <field name="signature" widget="signature"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- LIST -->
    <record id="view_visit_list" model="ir.ui.view">
        <field name="name">visit.visit.list</field>
        <field name="model">visit.visit</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'"
                  decoration-warning="state in ('en_route','in_process')"
                  decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="scheduled_date"/>
                <field name="employee_id"/>
                <field name="partner_id"/>
                <field name="visit_type"/>
                <field name="state"/>
                <field name="gps_valid" optional="show"/>
                <field name="duration" optional="show"/>
                <field name="km_traveled" optional="show"/>
                <field name="fuel_cost" optional="show"/>
            </list>
        </field>
    </record>

    <!-- CALENDAR -->
    <record id="view_visit_calendar" model="ir.ui.view">
        <field name="name">visit.visit.calendar</field>
        <field name="model">visit.visit</field>
        <field name="arch" type="xml">
            <calendar date_start="scheduled_date" color="employee_id">
                <field name="name"/>
                <field name="partner_id"/>
            </calendar>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_visit_visit" model="ir.actions.act_window">
        <field name="name">Visitas Comerciales</field>
        <field name="res_model">visit.visit</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay visitas programadas.
            </p>
        </field>
    </record>

    <record id="action_visit_my_visits" model="ir.actions.act_window">
        <field name="name">Mis Visitas</field>
        <field name="res_model">visit.visit</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
    </record>

</odoo>
