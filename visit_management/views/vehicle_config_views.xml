<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vehicle_config_form" model="ir.ui.view">
        <field name="name">visit.vehicle.config.form</field>
        <field name="model">visit.vehicle.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_visits" type="object"
                                class="oe_stat_button" icon="fa-car">
                            <field name="visit_count" widget="statinfo" string="Visitas"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="vehicle_type"/>
                            <field name="fuel_type"/>
                        </group>
                        <group>
                            <field name="km_per_unit"/>
                            <field name="fuel_price"/>
                            <field name="total_km"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vehicle_config_list" model="ir.ui.view">
        <field name="name">visit.vehicle.config.list</field>
        <field name="model">visit.vehicle.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="vehicle_type"/>
                <field name="fuel_type"/>
                <field name="km_per_unit"/>
                <field name="fuel_price"/>
                <field name="visit_count"/>
                <field name="total_km"/>
            </list>
        </field>
    </record>

    <record id="action_vehicle_config" model="ir.actions.act_window">
        <field name="name">Vehiculos</field>
        <field name="res_model">visit.vehicle.config</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
