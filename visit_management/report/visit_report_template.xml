<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_visit_template">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Reporte de Visita Comercial</h2>
                    <h3><t t-esc="doc.name"/></h3>
                    <table class="table table-bordered table-sm">
                        <tbody>
                            <tr>
                                <td><strong>Asesor:</strong></td>
                                <td><t t-esc="doc.employee_id.name"/></td>
                                <td><strong>Cliente:</strong></td>
                                <td><t t-esc="doc.partner_id.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Fecha:</strong></td>
                                <td><t t-esc="doc.scheduled_date"/></td>
                                <td><strong>Duracion:</strong></td>
                                <td><t t-esc="'%.0f min' % (doc.duration or 0)"/></td>
                            </tr>
                            <tr>
                                <td><strong>GPS Valido:</strong></td>
                                <td>
                                    <t t-if="doc.gps_valid">Si (<t t-esc="'%.0f m' % doc.gps_distance"/>)</t>
                                    <t t-else="">No</t>
                                </td>
                                <td><strong>KM Recorridos:</strong></td>
                                <td><t t-esc="'%.1f km' % (doc.km_traveled or 0)"/></td>
                            </tr>
                            <tr>
                                <td><strong>Costo Combustible:</strong></td>
                                <td><t t-esc="doc.fuel_cost"/></td>
                                <td><strong>Resultado:</strong></td>
                                <td><t t-esc="doc.result or '-'"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <h4>Comentarios de Cierre</h4>
                    <p><t t-esc="doc.closing_notes or '-'"/></p>
                    <t t-if="doc.signature">
                        <h4>Firma del Cliente</h4>
                        <p><t t-esc="doc.signature_name or ''"/></p>
                        <img t-att-src="image_data_uri(doc.signature)"
                             style="max-height:100px;"/>
                    </t>
                </div>
            </t>
        </t>
    </t>
</template>
</odoo>
