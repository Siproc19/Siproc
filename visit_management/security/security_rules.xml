<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Asesores solo ven sus propias visitas -->
        <record id="rule_visit_asesor_own" model="ir.rule">
            <field name="name">Visitas: Asesor - Solo sus propias visitas</field>
            <field name="model_id" ref="visit_management.model_visit_visit"/>
            <field name="groups" eval="[(4, ref('visit_management.group_visit_asesor'))]"/>
            <field name="domain_force">
                [('employee_id.user_id', '=', user.id)]
            </field>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Supervisores ven todas las visitas -->
        <record id="rule_visit_supervisor_all" model="ir.rule">
            <field name="name">Visitas: Supervisor - Todas las visitas</field>
            <field name="model_id" ref="visit_management.model_visit_visit"/>
            <field name="groups" eval="[(4, ref('visit_management.group_visit_supervisor'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Asesores solo ven sus propias rutas -->
        <record id="rule_route_asesor_own" model="ir.rule">
            <field name="name">Rutas: Asesor - Solo sus propias rutas</field>
            <field name="model_id" ref="visit_management.model_visit_route"/>
            <field name="groups" eval="[(4, ref('visit_management.group_visit_asesor'))]"/>
            <field name="domain_force">
                [('employee_id.user_id', '=', user.id)]
            </field>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Supervisores ven todas las rutas -->
        <record id="rule_route_supervisor_all" model="ir.rule">
            <field name="name">Rutas: Supervisor - Todas las rutas</field>
            <field name="model_id" ref="visit_management.model_visit_route"/>
            <field name="groups" eval="[(4, ref('visit_management.group_visit_supervisor'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
