<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_visit_asesor_own" model="ir.rule">
            <field name="name">Visitas: Asesor solo sus visitas</field>
            <field name="model_id" ref="visit_management.model_visit_visit"/>
            <field name="groups" eval="[(4, ref('visit_management.group_visit_asesor'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_visit_supervisor_all" model="ir.rule">
            <field name="name">Visitas: Supervisor todas</field>
            <field name="model_id" ref="visit_management.model_visit_visit"/>
            <field name="groups" eval="[(4, ref('visit_management.group_visit_supervisor'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_route_asesor_own" model="ir.rule">
            <field name="name">Rutas: Asesor solo sus rutas</field>
            <field name="model_id" ref="visit_management.model_visit_route"/>
            <field name="groups" eval="[(4, ref('visit_management.group_visit_asesor'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_route_supervisor_all" model="ir.rule">
            <field name="name">Rutas: Supervisor todas</field>
            <field name="model_id" ref="visit_management.model_visit_route"/>
            <field name="groups" eval="[(4, ref('visit_management.group_visit_supervisor'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
