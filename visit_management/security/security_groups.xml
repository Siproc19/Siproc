<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Grupo: Asesor -->
        <record id="group_visit_asesor" model="res.groups">
            <field name="name">Visitas / Asesor</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Grupo: Supervisor -->
        <record id="group_visit_supervisor" model="res.groups">
            <field name="name">Visitas / Supervisor</field>
            <field name="implied_ids" eval="[(4, ref('group_visit_asesor'))]"/>
        </record>

        <!-- Grupo: Gerencia -->
        <record id="group_visit_gerencia" model="res.groups">
            <field name="name">Visitas / Gerencia</field>
            <field name="implied_ids" eval="[(4, ref('group_visit_supervisor'))]"/>
        </record>

    </data>
</odoo>
