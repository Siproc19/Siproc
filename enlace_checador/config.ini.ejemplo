; Copia este archivo a "config.ini" (en la misma carpeta) y llena tus datos.
; No subas config.ini a ningún repositorio ni lo compartas: contiene el
; token que le da acceso a tu Odoo.

[checador]
; IP local del checador dentro de tu red de oficina (la que le configuraste
; en el menú de red del CLK-960).
ip = 192.168.1.201
puerto = 4370
; Clave de comunicación (comm key) del equipo. Déjala en 0 si no le
; configuraste una.
clave_comunicacion = 0
timeout = 10
forzar_udp = false

[odoo]
; Se copian de la ficha del checador en Odoo (Asistencias > Checadores
; Biométricos > tu checador), sección "Enlace desde la oficina".
webhook_url = https://tuempresa.odoo.com/steren_zk_attendance/push
token = PEGA_AQUI_EL_TOKEN_DE_LA_FICHA_DEL_CHECADOR
