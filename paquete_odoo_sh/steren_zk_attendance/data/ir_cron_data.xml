<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_zk_sync_attendance" model="ir.cron">
        <field name="name">Sincronizar checadores ZKTeco / Steren</field>
        <field name="model_id" ref="model_zk_biometric_device"/>
        <field name="state">code</field>
        <field name="code">model.search([('active', '=', True)]).action_download_attendance()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
