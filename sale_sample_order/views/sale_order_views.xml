<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formulario: casilla, referencias y botones del flujo de muestra -->
    <record id="view_order_form_sample" model="ir.ui.view">
        <field name="name">sale.order.form.sample.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_sample_order"
                       readonly="state not in ('sample', 'draft')"/>
                <field name="sample_reference"
                       invisible="not sample_reference"/>
                <field name="sample_picking_id"
                       invisible="not sample_picking_id"/>
                <field name="generated_order_id"
                       invisible="not generated_order_id"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_sample_trial"
                        type="object"
                        string="Se Queda en Prueba"
                        class="btn-primary"
                        confirm="El producto se dará de BAJA del inventario y ya no podrá registrarse como devuelto. ¿Continuar?"
                        invisible="state != 'sample'"/>
                <button name="action_create_sale_from_sample"
                        type="object"
                        string="Crear Orden de Venta"
                        invisible="state != 'sample' or generated_order_id"/>
                <button name="action_sample_cancel"
                        type="object"
                        string="Producto Devuelto (Cancelar)"
                        confirm="¿Confirmas que el producto de muestra fue devuelto? La orden de muestra se cancelará."
                        invisible="state != 'sample'"/>
            </xpath>
        </field>
    </record>

    <!-- Filtros en la vista de búsqueda -->
    <record id="view_sales_order_filter_sample" model="ir.ui.view">
        <field name="name">sale.order.search.sample.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="filter_sample_orders"
                        string="Órdenes de Muestra"
                        domain="[('is_sample_order', '=', True)]"/>
                <filter name="filter_sample_new"
                        string="Muestras en la Calle"
                        domain="[('is_sample_order', '=', True), ('state', '=', 'sample')]"/>
                <filter name="filter_sample_trial"
                        string="Órdenes de Prueba"
                        domain="[('is_sample_order', '=', True), ('state', '=', 'sample_trial')]"/>
            </xpath>
        </field>
    </record>

    <!-- Acción y menú: Ventas > Órdenes de Muestra -->
    <record id="action_sample_orders" model="ir.actions.act_window">
        <field name="name">Órdenes de Muestra</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,kanban,activity</field>
        <field name="domain">[('is_sample_order', '=', True)]</field>
        <field name="context">{'default_is_sample_order': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una nueva Orden de Muestra
            </p>
            <p>
                Mientras el documento está como Orden de Muestra, el producto
                puede regresar (Producto Devuelto) o venderse (Crear Orden de
                Venta). Si se queda con el cliente, "Se Queda en Prueba" lo
                convierte en Orden de Prueba y da de baja el inventario.
            </p>
        </field>
    </record>

    <menuitem id="menu_sample_orders"
              name="Órdenes de Muestra"
              parent="sale.sale_order_menu"
              action="action_sample_orders"
              sequence="6"/>

</odoo>
