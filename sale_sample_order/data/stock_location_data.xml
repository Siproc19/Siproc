<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Ubicación antigua (v4.0, interna). Se conserva para no romper
         bases que ya la usaron; el módulo ya no la utiliza. -->
    <record id="stock_location_samples" model="stock.location">
        <field name="name">Muestras (obsoleta)</field>
        <field name="usage">internal</field>
        <field name="location_id" ref="stock.stock_location_locations"/>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Ubicación vigente: tipo cliente. El producto trasladado aquí se
         descuenta del stock disponible en toda la empresa. -->
    <record id="stock_location_samples_customer" model="stock.location">
        <field name="name">Muestras</field>
        <field name="usage">customer</field>
        <field name="location_id" ref="stock.stock_location_customers"/>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
