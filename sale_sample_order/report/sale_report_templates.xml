<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_saleorder_document_sample"
              inherit_id="sale.report_saleorder_document">

        <!-- Título del PDF -->
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title">
                <span t-if="doc.is_sample_order and doc.state == 'sample_trial'">Orden de Prueba # </span>
                <span t-elif="doc.is_sample_order">Orden de Muestra # </span>
                <span t-elif="is_proforma">Factura Pro-Forma # </span>
                <span t-elif="doc.state in ['draft','sent']">Cotización # </span>
                <span t-else="">Orden # </span>
                <span t-field="doc.name">SO0000</span>
            </t>
        </xpath>

        <!-- Leyenda del documento de muestra -->
        <xpath expr="//div[@id='informations']" position="before">
            <div t-if="doc.is_sample_order and doc.state in ['sample', 'sample_trial']"
                 style="border: 2px solid #b91c1c; color: #b91c1c; padding: 8px 12px; margin-bottom: 12px; text-align: center; border-radius: 4px;">
                <strong t-if="doc.state == 'sample'">ORDEN DE MUESTRA</strong>
                <strong t-if="doc.state == 'sample_trial'">ORDEN DE PRUEBA — PRODUCTO EN PRUEBA CON EL CLIENTE</strong><br/>
                Documento de control de producto en muestra.
                No constituye venta ni afecta inventario.
            </div>
        </xpath>

    </template>

</odoo>
