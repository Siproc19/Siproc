<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Botón "Generar código interno" en la ficha de la plantilla de producto -->
    <record id="view_product_template_form_barcode_autogen" model="ir.ui.view">
        <field name="name">product.template.form.barcode.autogen</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="barcode" position="after">
                <button name="action_generate_internal_barcode"
                        type="object"
                        string="Generar código interno"
                        class="btn-link"
                        icon="fa-barcode"
                        invisible="barcode"/>
            </field>
        </field>
    </record>

    <!-- Botón "Generar código interno" en la ficha de la variante -->
    <record id="view_product_product_form_barcode_autogen" model="ir.ui.view">
        <field name="name">product.product.form.barcode.autogen</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <field name="barcode" position="after">
                <button name="action_generate_internal_barcode"
                        type="object"
                        string="Generar código interno"
                        class="btn-link"
                        icon="fa-barcode"
                        invisible="barcode"/>
            </field>
        </field>
    </record>

    <!-- Acción masiva desde la lista de plantillas de producto -->
    <record id="action_generate_internal_barcode_template" model="ir.actions.server">
        <field name="name">Generar código de barras interno</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_generate_internal_barcode()</field>
    </record>

    <!-- Acción masiva desde la lista de variantes de producto -->
    <record id="action_generate_internal_barcode_product" model="ir.actions.server">
        <field name="name">Generar código de barras interno</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_generate_internal_barcode()</field>
    </record>

</odoo>
