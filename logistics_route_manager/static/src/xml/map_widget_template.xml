<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="logistics_route_manager.RouteMapWidget">
        <div class="o_logistics_map_widget">

            <div t-if="state.error" class="alert alert-warning" role="alert">
                <t t-esc="state.error"/>
            </div>

            <t t-if="!state.error">
                <div class="o_logistics_map_bar">
                    <div class="o_logistics_map_status">
                        <span t-attf-class="o_logistics_dot {{ state.driverOnline ? 'is-online' : 'is-offline' }}"/>
                        <span t-esc="state.driverOnline ? 'Piloto en línea' : 'Piloto sin señal'"/>
                        <span class="o_logistics_sep">·</span>
                        <span><t t-esc="state.driverSpeed"/> km/h</span>
                        <span class="o_logistics_sep">·</span>
                        <span>
                            <t t-esc="state.completedTasks"/> / <t t-esc="state.totalTasks"/> paradas
                            (<t t-esc="state.progress"/>%)
                        </span>
                    </div>

                    <div class="o_logistics_map_actions">
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                t-on-click="() => this.centerOnDriver()">
                            Centrar en piloto
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                t-on-click="() => this.fitAll()">
                            Ver toda la ruta
                        </button>
                        <button type="button"
                                t-attf-class="btn btn-sm {{ state.followDriver ? 'btn-primary' : 'btn-outline-secondary' }}"
                                t-on-click="() => this.toggleFollow()">
                            Seguir piloto
                        </button>
                        <button type="button"
                                t-attf-class="btn btn-sm {{ state.showTrack ? 'btn-primary' : 'btn-outline-secondary' }}"
                                t-on-click="() => this.toggleTrack()">
                            Recorrido
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-info"
                                t-on-click="() => this.openIn('waze')">
                            Waze
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-info"
                                t-on-click="() => this.openIn('gmaps')">
                            Google Maps
                        </button>
                    </div>
                </div>

                <div t-if="state.deviated" class="alert alert-warning o_logistics_deviation" role="alert">
                    <strong>Desvío detectado.</strong> <t t-esc="state.deviationMessage"/>
                </div>

                <div class="o_logistics_map_canvas" t-ref="map"/>

                <div class="o_logistics_map_legend">
                    <span><i style="background:#6c757d;"/> Pendiente</span>
                    <span><i style="background:#0dcaf0;"/> En tránsito</span>
                    <span><i style="background:#ffc107;"/> En sitio</span>
                    <span><i style="background:#198754;"/> Completada</span>
                    <span><i style="background:#dc3545;"/> Fallida</span>
                    <span><i class="o_logistics_legend_line"/> Recorrido real</span>
                </div>
            </t>
        </div>
    </t>

</templates>
