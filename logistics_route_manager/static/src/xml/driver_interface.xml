<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <template id="driver_app_template" name="App del Piloto">
        <t t-call="web.layout">
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"/>
                <meta name="theme-color" content="#2b3714"/>
                <meta name="mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
                <link rel="manifest" href="/logistics/manifest.json"/>
                <link rel="stylesheet" href="/logistics_route_manager/static/src/css/mobile_driver.css"/>
                <title>LogiPiloto</title>
            </t>
            <!-- Banner sin conexión -->
                <div id="offline-banner">
                    ⚠️ Sin conexión — Las posiciones GPS se guardarán y enviarán al reconectar
                </div>

                <!-- Header -->
                <header class="driver-header">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <div>
                            <h1>🚗 <t t-esc="driver.name"/></h1>
                            <div class="subtitle">
                                <t t-if="route">
                                    <t t-esc="route.name"/> · <t t-esc="route.date"/>
                                </t>
                                <t t-else="">Sin ruta asignada hoy</t>
                            </div>
                        </div>
                        <div id="driver-speed" style="font-size:22px; font-weight:900; color:#e9ab21;">
                            0 km/h
                        </div>
                    </div>
                </header>

                <!-- GPS status -->
                <div class="gps-status" id="gps-status">
                    <div class="gps-dot"/>
                    GPS activo — Enviando posición cada <t t-esc="gps_interval"/> segundos
                </div>

                <!-- Barra de progreso -->
                <div class="progress-section">
                    <span id="progress-label">Cargando ruta...</span>
                    <div class="progress-bar-track">
                        <div id="progress-bar" style="width:0%"/>
                    </div>
                </div>

                <!-- Botón Iniciar Ruta (si no está iniciada) -->
                <t t-if="route and route.state == 'confirmed'">
                    <div style="padding:16px;">
                        <button id="start-route-btn" style="width:100%; padding:20px; background:linear-gradient(135deg,#4a5b25,#63783a); color:white; border:none; border-radius:14px; font-size:20px; font-weight:900; cursor:pointer; box-shadow:0 4px 16px rgba(74,91,37,0.42);">
                            🚀 INICIAR RUTA
                        </button>
                    </div>
                </t>

                <!-- Lista de tareas -->
                <div id="task-list">
                    <t t-if="not route">
                        <div style="text-align:center; padding:60px 24px; color:#6c757d;">
                            <div style="font-size:64px; margin-bottom:16px;">📋</div>
                            <h3>No tienes rutas asignadas para hoy</h3>
                            <p style="margin-top:8px;">Consulta con tu jefe de logística.</p>
                        </div>
                    </t>
                </div>

                <!-- Toast container -->
                <div id="toast-container"/>

                <!-- Modal: Completar tarea -->
                <div id="complete-modal" class="modal-overlay" data-task-id="">
                    <div class="modal-sheet">
                        <div class="modal-title">
                            ✅ Completar Tarea
                            <button class="close-modal">✕</button>
                        </div>
                        <label class="photo-upload-label">
                            📷 Tomar/Subir Foto de Evidencia
                            <input type="file" id="evidence-photo" accept="image/*" capture="environment"/>
                        </label>
                        <img id="evidence-preview" alt="Foto de evidencia"
                             style="display:none; width:100%; border-radius:12px; margin-bottom:12px;"/>
                        <div style="margin-bottom:12px;">
                            <label style="font-size:14px; font-weight:600; margin-bottom:6px; display:block;">
                                ✍️ Firma del Receptor (dibuja en el recuadro)
                            </label>
                            <canvas id="signature-canvas"/>
                            <button type="button" id="clear-signature" style="font-size:12px; color:#dc3545; background:none; border:none; cursor:pointer; padding:4px;">
                                🗑️ Limpiar firma
                            </button>
                        </div>
                        <input type="text" id="signature-name" class="modal-input" placeholder="Nombre del firmante (opcional)"/>
                        <input type="number" id="spent-amount" class="modal-input" placeholder="Monto gastado en Q (si aplica)" step="0.01"/>
                        <button id="complete-modal-confirm" class="modal-confirm-btn success">
                            ✅ Confirmar Completado
                        </button>
                    </div>
                </div>

                <!-- Modal: Reportar problema -->
                <div id="fail-modal" class="modal-overlay" data-task-id="">
                    <div class="modal-sheet">
                        <div class="modal-title">
                            ❌ Reportar Problema
                            <button class="close-modal">✕</button>
                        </div>
                        <textarea id="fail-reason" class="modal-input" placeholder="Describe el problema (cliente no disponible, negocio cerrado, dirección incorrecta...)" rows="4" style="resize:none;"/>
                        <button id="fail-modal-confirm" class="modal-confirm-btn danger">
                            ❌ Reportar Problema
                        </button>
                    </div>
                </div>

                <!-- Scripts -->
                <script src="/logistics_route_manager/static/src/js/gps_tracker.js"/>
                <script src="/logistics_route_manager/static/src/js/driver_app.js"/>
                <script>
                    // Iniciar la app del piloto
                    document.addEventListener("DOMContentLoaded", () =&gt; {
                        initDriverApp({
                            driverId:   <t t-esc="driver.id"/>,
                            routeId:    <t t-if="route"><t t-esc="route.id"/></t><t t-else="">null</t>,
                            routeData:  <t t-out="route_data"/>,
                            apiKey:     "<t t-esc="api_key"/>",
                            gpsInterval: <t t-esc="gps_interval"/>,
                            token:      "<t t-esc="token"/>",
                        });
                    });
                </script>
            </t>
    </template>
</odoo>