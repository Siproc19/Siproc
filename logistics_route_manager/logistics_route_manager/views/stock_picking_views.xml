<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Formulario de la transferencia: pestaña de Logística.

        Se engancha solo a //notebook, que existe con certeza en la vista de
        stock. Se evita a propósito el oe_button_box, cuyo contenido cambia
        entre versiones de Odoo y haría fallar la instalación.
    -->
    <record id="stock_picking_form_logistics" model="ir.ui.view">
        <field name="name">stock.picking.form.logistics</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="🚚 Logística" name="logistics">
                    <field name="x_has_logistics_route" invisible="1"/>
                    <field name="x_delivery_proof_url" invisible="1"/>

                    <div class="alert alert-info" role="status"
                         invisible="x_has_logistics_route">
                        Esta entrega todavía no está en ninguna ruta.
                        Selecciónela en la lista de Transferencias y use
                        <b>Acciones → Crear ruta desde entregas</b>.
                    </div>

                    <group invisible="not x_has_logistics_route">
                        <group string="Asignación">
                            <field name="x_delivery_status"/>
                            <field name="x_logistics_route_id" readonly="1"/>
                            <field name="x_logistics_driver_id" readonly="1"/>
                            <field name="x_logistics_vehicle_id" readonly="1"/>
                            <field name="x_logistics_date" readonly="1"/>
                        </group>
                        <group string="Prueba de Entrega"
                               invisible="x_delivery_status != 'delivered'">
                            <field name="x_delivered_at" readonly="1"/>
                            <field name="x_receiver_name" readonly="1"/>
                            <field name="x_delivered_latitude" readonly="1"/>
                            <field name="x_delivered_longitude" readonly="1"/>
                            <button type="object" name="action_open_delivery_location"
                                    string="Ver en el mapa dónde se entregó"
                                    class="btn-link" icon="fa-map-marker"
                                    invisible="not x_delivery_proof_url"/>
                        </group>
                    </group>

                    <div invisible="not x_has_logistics_route">
                        <button type="object" name="action_open_logistics_route"
                                string="Abrir la ruta" class="btn-secondary"
                                icon="fa-truck"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Lista de transferencias: estado logístico y piloto -->
    <record id="stock_picking_tree_logistics" model="ir.ui.view">
        <field name="name">stock.picking.list.logistics</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="x_delivery_status" optional="show" string="Entrega"
                       widget="badge"
                       decoration-success="x_delivery_status == 'delivered'"
                       decoration-danger="x_delivery_status == 'failed'"
                       decoration-info="x_delivery_status == 'in_transit'"
                       decoration-warning="x_delivery_status == 'planned'"
                       decoration-muted="x_delivery_status == 'no_route'"/>
                <field name="x_logistics_driver_id" optional="hide" string="Piloto"/>
                <field name="x_logistics_route_id" optional="hide" string="Ruta"/>
            </xpath>
        </field>
    </record>

    <!-- Búsqueda: filtros para armar la ruta del día -->
    <record id="stock_picking_search_logistics" model="ir.ui.view">
        <field name="name">stock.picking.search.logistics</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="filter_sin_ruta" string="Sin ruta asignada"
                        domain="[('x_logistics_route_id', '=', False),
                                 ('picking_type_code', '=', 'outgoing'),
                                 ('state', 'not in', ('done', 'cancel'))]"/>
                <filter name="filter_en_ruta" string="En ruta"
                        domain="[('x_delivery_status', 'in', ('planned', 'in_transit'))]"/>
                <filter name="filter_entregado_ruta" string="Entregado en ruta"
                        domain="[('x_delivery_status', '=', 'delivered')]"/>
                <filter name="filter_no_entregado" string="No entregado"
                        domain="[('x_delivery_status', '=', 'failed')]"/>
                <!--
                    Odoo 19 ya no admite <group expand="0"> con filtros dentro
                    de una vista de búsqueda: el esquema exige que <group> solo
                    contenga campos. Los filtros con context group_by se ponen
                    sueltos y Odoo los agrupa solo en el menú "Agrupar por".
                -->
                <separator/>
                <filter name="group_logistics_route" string="Ruta"
                        context="{'group_by': 'x_logistics_route_id'}"/>
                <filter name="group_logistics_driver" string="Piloto"
                        context="{'group_by': 'x_logistics_driver_id'}"/>
                <filter name="group_delivery_status" string="Estado de Entrega"
                        context="{'group_by': 'x_delivery_status'}"/>
            </xpath>
        </field>
    </record>

</odoo>
