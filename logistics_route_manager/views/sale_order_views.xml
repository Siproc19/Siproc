<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Pedido de venta: estado logístico visible para Ventas -->
    <record id="sale_order_form_logistics" model="ir.ui.view">
        <field name="name">sale.order.form.logistics</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button type="object" name="action_view_logistics_routes"
                        class="oe_stat_button" icon="fa-truck"
                        groups="logistics_route_manager.group_logistics_manager,logistics_route_manager.group_logistics_user,logistics_route_manager.group_logistics_driver"
                        invisible="logistics_route_count == 0">
                    <field name="logistics_route_count" widget="statinfo"
                           string="Rutas"/>
                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="🚚 Logística" name="logistics"
                      invisible="logistics_status == 'no_route'">
                    <group>
                        <group string="Ruta">
                            <field name="logistics_status"/>
                            <field name="logistics_route_date"/>
                            <field name="logistics_driver_name"/>
                            <field name="logistics_vehicle_name"/>
                            <field name="logistics_delivered_at"
                                   invisible="logistics_status != 'delivered'"/>
                        </group>
                    </group>

                    <field name="logistics_task_ids" readonly="1"
                           groups="logistics_route_manager.group_logistics_manager,logistics_route_manager.group_logistics_user,logistics_route_manager.group_logistics_driver">
                        <list string="Paradas">
                            <field name="route_id"/>
                            <field name="sequence" string="Orden"/>
                            <field name="name"/>
                            <field name="address"/>
                            <field name="estimated_arrival"/>
                            <field name="actual_departure" string="Entregado el"/>
                            <field name="signature_name" string="Recibió"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'completed'"
                                   decoration-danger="state == 'failed'"
                                   decoration-warning="state == 'arrived'"
                                   decoration-info="state == 'in_transit'"
                                   decoration-muted="state == 'pending'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Lista de pedidos: estado logístico como columna opcional -->
    <record id="sale_order_tree_logistics" model="ir.ui.view">
        <field name="name">sale.order.list.logistics</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="logistics_status" optional="hide" string="Logística"
                       widget="badge"
                       decoration-success="logistics_status == 'delivered'"
                       decoration-danger="logistics_status == 'failed'"
                       decoration-info="logistics_status == 'in_transit'"
                       decoration-warning="logistics_status == 'partial'"
                       decoration-muted="logistics_status == 'no_route'"/>
                <field name="logistics_driver_name" optional="hide" string="Piloto"/>
            </xpath>
        </field>
    </record>

    <!-- Orden de compra: a dónde va el piloto y en qué va -->
    <record id="purchase_order_form_logistics" model="ir.ui.view">
        <field name="name">purchase.order.form.logistics</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button type="object" name="action_view_logistics_routes"
                        class="oe_stat_button" icon="fa-truck"
                        groups="logistics_route_manager.group_logistics_manager,logistics_route_manager.group_logistics_user,logistics_route_manager.group_logistics_driver"
                        invisible="logistics_task_count == 0">
                    <field name="logistics_task_count" widget="statinfo"
                           string="Paradas"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="logistics_status"
                       invisible="logistics_status == 'no_route'"/>
            </xpath>
        </field>
    </record>

</odoo>
